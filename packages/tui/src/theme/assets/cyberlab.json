{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ink0": "#070b09",
    "ink1": "#0b100d",
    "ink2": "#111a15",
    "ink3": "#1c2b22",
    "emerald": "#10b981",
    "emeraldHi": "#34d399",
    "emeraldDim": "#059669",
    "mint": "#a7f3d0",
    "cyan": "#22d3ee",
    "teal": "#2dd4bf",
    "amber": "#fbbf24",
    "red": "#f87171",
    "blue": "#60a5fa",
    "gray": "#8ba89a",
    "lightBg": "#f0fdf4",
    "lightPaper": "#dcfce7",
    "lightInk1": "#bbf7d0",
    "lightText": "#064e3b",
    "lightGray": "#6b8f7f"
  },
  "theme": {
    "primary": { "dark": "emerald", "light": "emeraldDim" },
    "secondary": { "dark": "cyan", "light": "teal" },
    "accent": { "dark": "teal", "light": "teal" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "amber", "light": "amber" },
    "success": { "dark": "emeraldHi", "light": "emeraldDim" },
    "info": { "dark": "blue", "light": "blue" },
    "text": { "dark": "mint", "light": "lightText" },
    "textMuted": { "dark": "gray", "light": "lightGray" },
    "background": { "dark": "ink0", "light": "lightBg" },
    "backgroundPanel": { "dark": "ink1", "light": "lightPaper" },
    "backgroundElement": { "dark": "ink2", "light": "lightInk1" },
    "border": { "dark": "ink3", "light": "lightGray" },
    "borderActive": { "dark": "emerald", "light": "emeraldDim" },
    "borderSubtle": { "dark": "ink2", "light": "lightInk1" },
    "diffAdded": { "dark": "emeraldDim", "light": "emeraldDim" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "gray", "light": "lightGray" },
    "diffHunkHeader": { "dark": "blue", "light": "blue" },
    "diffHighlightAdded": { "dark": "#6ee7b7", "light": "#10b981" },
    "diffHighlightRemoved": { "dark": "#fca5a5", "light": "#dc2626" },
    "diffAddedBg": { "dark": "#0d1f16", "light": "#d1fae5" },
    "diffRemovedBg": { "dark": "#221114", "light": "#fee2e2" },
    "diffContextBg": { "dark": "ink1", "light": "lightPaper" },
    "diffLineNumber": { "dark": "textMuted", "light": "#4b6b5c" },
    "diffAddedLineNumberBg": { "dark": "#0a1a10", "light": "#a7f3d0" },
    "diffRemovedLineNumberBg": { "dark": "#1a1010", "light": "#fecaca" },
    "markdownText": { "dark": "mint", "light": "lightText" },
    "markdownHeading": { "dark": "cyan", "light": "teal" },
    "markdownLink": { "dark": "blue", "light": "blue" },
    "markdownLinkText": { "dark": "teal", "light": "teal" },
    "markdownCode": { "dark": "emeraldDim", "light": "emeraldDim" },
    "markdownBlockQuote": { "dark": "gray", "light": "lightGray" },
    "markdownEmph": { "dark": "amber", "light": "amber" },
    "markdownStrong": { "dark": "emeraldHi", "light": "emeraldDim" },
    "markdownHorizontalRule": { "dark": "gray", "light": "lightGray" },
    "markdownListItem": { "dark": "blue", "light": "blue" },
    "markdownListEnumeration": { "dark": "teal", "light": "teal" },
    "markdownImage": { "dark": "blue", "light": "blue" },
    "markdownImageText": { "dark": "teal", "light": "teal" },
    "markdownCodeBlock": { "dark": "mint", "light": "lightText" },
    "syntaxComment": { "dark": "gray", "light": "lightGray" },
    "syntaxKeyword": { "dark": "teal", "light": "teal" },
    "syntaxFunction": { "dark": "blue", "light": "blue" },
    "syntaxVariable": { "dark": "mint", "light": "lightText" },
    "syntaxString": { "dark": "emeraldDim", "light": "emeraldDim" },
    "syntaxNumber": { "dark": "amber", "light": "amber" },
    "syntaxType": { "dark": "emeraldHi", "light": "emeraldDim" },
    "syntaxOperator": { "dark": "cyan", "light": "teal" },
    "syntaxPunctuation": { "dark": "mint", "light": "lightText" }
  }
}
