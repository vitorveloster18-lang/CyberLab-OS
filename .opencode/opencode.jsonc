{
  "$schema": "https://opencode.ai/config.json",
  // CyberLab OS: modelo gratuito padrão (sem API key) para o TUI funcionar
  // logo após o clone, sem configuração manual.
  "model": "opencode/deepseek-v4.1-flash-free",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  // CyberLab OS: skills operacionais vivem em skills/ (raiz do repo), que é
  // também o diretório lido pelo CyberLabSkillCatalog. Sem isto o agente
  // não enxerga as skills de cybersegurança.
  "skills": ["../skills"],
  // CyberLab OS: handoff de sessão para investigações longas (preserva
  // contexto entre sessões do Orchestrator).
  "plugin": ["opencode-session-handoff"],
  // CyberLab OS: servidor MCP da Biblioteca de Conhecimento + memória
  // investigativa (search_knowledge, read_document, investigation_memory_*).
  // Sem isto o Orchestrator não acessa a biblioteca nem a memória.
  //
  // "cwd": "../.." — o OpenCode spawna o servidor com cwd = diretório da
  // sessão (packages/cli no launch padrão `bun run cyberlab:tui`), e o
  // caminho do script é relativo. Sem o cwd, o spawn falha com
  // "Module not found cyberlab/mcp/knowledge-mcp-stdio.ts". O servidor
  // também usa process.cwd() como workspaceRoot (vault em <repo>/vault),
  // então o cwd precisa ser a raiz do repo. Se abrir o TUI a partir da
  // raiz do repo, troque para ".".
  "mcp": {
    "servers": {
      "cyberlab-knowledge": {
        "type": "local",
        "command": ["bun", "run", "cyberlab/mcp/knowledge-mcp-stdio.ts"],
        "cwd": "../.."
      }
    }
  },
  "tools": {
    "github-pr-search": false,
  },
}
